// 다이즈하이미디어 공식 문서 시스템 — Cloudflare Pages 설정
// 주소: https://disedocs.pages.dev   배포 안내: worker/README.md
//   npm run build  →  dist/ (사이트 파일 + _worker.js)
//   npx wrangler pages deploy --branch main
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "disedocs",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // 직원 명부·허용 도메인·작업 기록·로그인 세션
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dise-docs",
      "database_id": "521332e4-5914-4eb3-b084-21c2dea219d0",
      "migrations_dir": "migrations"
    }
  ],

  // PDF 만들기(Cloudflare Browser Rendering)
  "browser": { "binding": "BROWSER" },

  "vars": {
    // 항상 관리자(잠김 방지). 쉼표로 여러 명.
    // 첫 비밀번호는 /setup 에서 — 설정 코드: npx wrangler pages secret put SETUP_CODE
    "ADMIN_EMAILS": "charlie@disehimedia.com"
  }
}
